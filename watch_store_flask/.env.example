# Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Flask App Secret Key
SECRET_KEY=dev-secret-key-change-in-production-123456

# Environment: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=1

# MongoDB Configuration
# Local MongoDB URI: mongodb://localhost:27017/watch_store
# Set USE_MONGOMOCK=True if you do not have a local MongoDB server installed
MONGO_URI=mongodb://localhost:27017/watch_store
USE_MONGOMOCK=False

# Flask-Mail (SMTP) Configuration (Example values only)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=WatchStore <no-reply@watchstore.com>

# External Network API Configuration
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
VIETQR_API_URL=https://api.vietqr.io/v2/banks
